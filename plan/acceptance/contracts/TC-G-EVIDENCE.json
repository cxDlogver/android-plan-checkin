  "definition": {
    "id": "TC-G-EVIDENCE",
    "title": "视觉验收证据完整性",
    "kind": "constraint",
    "requirementId": null,
    "given": {
      "stateId": null,
      "setup": "准备完整的验收记录，并逐项构造缺少版本、页面节点、环境、输入、截图或差异说明的记录。",
      "verify": "确认上述准备已经完成，测试数据相互隔离，再按当前操作执行检查。"
    },
    "operation": {
      "label": "验证证据字段与未执行状态规则",
      "actor": "验收者"
    },
    "expected": {
      "stateId": null,
      "conclusion": "不完整的记录不能形成通过结论；未执行的用例保持未执行，完整记录也不能自动代表验收通过。"
    },
    "dataProfileId": "isolated-checks",
    "mocks": [],
    "acceptance": {
      "visual": {
        "applicable": false,
        "reason": "本例检查记录规则，不验证画面外观。",
        "checks": []
      },
      "functional": {
        "applicable": true,
        "reason": "核对证据记录器的数据校验与状态约束。",
        "checks": [
          {
            "criterion": "证据记录完整性和验收状态规则得到执行，缺字段或伪造通过的记录被拒绝。",
            "oracle": "PRD A07和L93；每次实际观察绑定当前UI版本、节点、环境和输入",
            "procedure": "逐项删除记录字段并断言拒绝；为not_run附加actual或通过标记时拒绝；完整结构只能通过记录校验，不能自动改变产品验收状态。",
            "evidence": [
              {
                "form": "data-snapshot",
                "description": "完整、缺字段及错误状态的测试记录。"
              },
              {
                "form": "assertion-report",
                "description": "每种记录应接受或拒绝的独立预期、实际结果及状态检查结论。"
              }
            ],
            "sufficiency": "纯记录结构与状态约束可由单元测试验收，无需浏览器。",
            "testType": "script",
            "environment": "runtime"
          }
        ]
      }
    },
    "constraintIds": [
      "G-evidence"
    ],
    "impactId": null,
    "dataProfile": {
      "id": "isolated-checks",
      "scope": "case",
      "preparation": "每项独立检查创建隔离ctx、依赖spy及真实呈现组件；从正式允许入口呈现对应document，检查内部可顺序浏览所需页面，不把fixture终点作为非起始主用例的进入捷径。独立检查结束恢复全部环境/spy。",
      "continuity": "独立用例不向主路线传递对象或状态；矩阵变更输入时重建隔离ctx，验收每一行使用该行自己的输入。",
      "fields": [
        {
          "name": "responsiveCases",
          "type": "array",
          "mode": "context",
          "resolve": "读取rules.profiles.mobile.validationCases及breakpointBoundaryCases；逐项执行。width>=768只核对缺少desktop的输入契约，不凭空创建桌面稿。",
          "oracle": "宽度分类由768唯一断点判断；逻辑尺寸、contentMaxWidth、滚动/安全区/键盘所有权均按rules计算。",
