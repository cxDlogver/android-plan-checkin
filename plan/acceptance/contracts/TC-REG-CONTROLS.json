  "definition": {
    "id": "TC-REG-CONTROLS",
    "title": "公共控件的禁用、选择、输入及可访问契约",
    "kind": "regression",
    "requirementId": null,
    "given": {
      "stateId": null,
      "setup": "在隔离测试宿主挂载真实按钮、选项和输入控件，分别准备启用、禁用、选中、输入和错误提示场景。",
      "verify": "确认上述准备已经完成，测试数据相互隔离，再按当前操作执行检查。"
    },
    "operation": {
      "label": "修改样式后执行启用/禁用点击、选项切换与文字输入",
      "actor": "验收者"
    },
    "expected": {
      "stateId": null,
      "conclusion": "禁用控件不会触发动作；启用后只触发一次正确动作；选中值、输入值和可访问属性正确传递，错误提示仍可被读取。"
    },
    "dataProfileId": "isolated-checks",
    "mocks": [],
    "acceptance": {
      "visual": {
        "applicable": false,
        "reason": "本例回归控件行为，颜色与布局由视觉用例覆盖。",
        "checks": []
      },
      "functional": {
        "applicable": true,
        "reason": "核对公共控件改动可能直接破坏的事件和属性契约。",
        "checks": [
          {
            "criterion": "公共控件的禁用、点击、选项切换、受控输入和可访问属性保持原有行为。",
            "oracle": "src/ui/metal.tsx Button/Choice/Field现有公开props与Pressable/TextInput契约",
            "procedure": "组件测试宿主挂载实际控件，依次触发disabled点击、enabled点击、Choice选项与Field输入；spy核对次数/值，查询accessibilityState和alert；不Mock被测控件。",
            "evidence": [
              {
                "form": "native-tree",
                "description": "真实控件的文本、选中、禁用及错误提示属性。"
              },
              {
                "form": "call-trace",
                "description": "点击、选项切换和文字输入触发的参数与次数。"
              },
              {
                "form": "assertion-report",
                "description": "控件行为和属性保持不变的预期与实际对照。"
              }
            ],
            "sufficiency": "足以验证拟改公共组件的直接行为风险；颜色布局由主用例/全局视觉检查覆盖，无需浏览器。",
            "testType": "script",
            "environment": "native"
          }
        ]
      }
    },
    "constraintIds": [],
    "impactId": "I-CONTROLS",
    "dataProfile": {
      "id": "isolated-checks",
      "scope": "case",
      "preparation": "每项独立检查创建隔离ctx、依赖spy及真实呈现组件；从正式允许入口呈现对应document，检查内部可顺序浏览所需页面，不把fixture终点作为非起始主用例的进入捷径。独立检查结束恢复全部环境/spy。",
      "continuity": "独立用例不向主路线传递对象或状态；矩阵变更输入时重建隔离ctx，验收每一行使用该行自己的输入。",
      "fields": [
        {
          "name": "responsiveCases",
          "type": "array",
          "mode": "context",
          "resolve": "读取rules.profiles.mobile.validationCases及breakpointBoundaryCases；逐项执行。width>=768只核对缺少desktop的输入契约，不凭空创建桌面稿。",
          "oracle": "宽度分类由768唯一断点判断；逻辑尺寸、contentMaxWidth、滚动/安全区/键盘所有权均按rules计算。",
