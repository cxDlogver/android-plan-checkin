{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "taskPlanPath": {
      "type": "string",
      "minLength": 1
    },
    "planContract": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "implementation": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "startedAt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "completedAt": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "startedAt",
                  "completedAt"
                ],
                "additionalProperties": false
              }
            ]
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "done": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 0
                },
                "observation": {
                  "type": "string",
                  "minLength": 1
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "index",
                "observation",
                "sources"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "typecheck",
                    "lint",
                    "format-check",
                    "static-analysis"
                  ]
                },
                "command": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "cwd": {
                  "type": "string",
                  "minLength": 1
                },
                "startedAt": {
                  "type": "string",
                  "minLength": 1
                },
                "finishedAt": {
                  "type": "string",
                  "minLength": 1
                },
                "exitCode": {
                  "type": "integer"
                },
                "log": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "path",
                    "sha256"
                  ],
                  "additionalProperties": false
                },
                "files": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "kind",
                "command",
                "cwd",
                "startedAt",
                "finishedAt",
                "exitCode",
                "log",
                "files"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          }
        },
        "required": [
          "implementation",
          "resources",
          "done",
          "files",
          "checks"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "taskPlanPath",
    "planContract",
    "tasks"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
