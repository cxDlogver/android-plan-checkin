{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:requirement-analysis:2.0.0",
  "title": "状态迁移图",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "states": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/state"
      },
      "minItems": 0
    },
    "transitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transition"
      },
      "minItems": 0
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      },
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "title",
    "revision",
    "states",
    "transitions",
    "constraints"
  ],
  "additionalProperties": false,
  "$defs": {
    "source": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "document"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "locator": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "quote": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "path",
            "locator",
            "sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "ui"
            },
            "structurePath": {
              "type": "string",
              "minLength": 1
            },
            "documentId": {
              "type": "string",
              "minLength": 1
            },
            "nodeIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "structureSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "screenshotPath": {
              "type": "string",
              "minLength": 1
            },
            "screenshotSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "kind",
            "structurePath",
            "documentId",
            "nodeIds",
            "structureSha256",
            "screenshotPath",
            "screenshotSha256"
          ],
          "additionalProperties": false
        }
      ]
    },
    "assertion": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "enum": [
            "eq",
            "in",
            "exists",
            "count-eq",
            "eq-ref",
            "matches-ui"
          ]
        },
        "value": true
      },
      "required": [
        "path",
        "op",
        "value"
      ],
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "description": "按对象、属性或内容、期望值陈述事实。"
        },
        "assertion": {
          "$ref": "#/$defs/assertion",
          "description": "定位判断对象并给出比较方式和实际期望。"
        },
        "observation": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1,
              "description": "需求允许使用的界面检查、查询或其他观察方法。"
            },
            "locator": {
              "type": "string",
              "minLength": 1,
              "description": "能够定位被观察对象、区域、节点或数据项的位置。"
            }
          },
          "required": [
            "method",
            "locator"
          ],
          "additionalProperties": false,
          "description": "说明当前事实的实际观察方法和位置。"
        }
      },
      "required": [
        "statement",
        "assertion",
        "observation"
      ],
      "additionalProperties": false,
      "description": "包含观察对象、属性或内容及期望值的可判定事实。"
    },
    "state": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "图内唯一且稳定的状态身份。"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "简短说明当前可观察场景。"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "description": "说明本状态同时成立、需要识别和验收的事实。"
        },
        "isInitial": {
          "type": "boolean",
          "description": "标记全图允许直接进入或通过已明确准备进入的起点；并非某条迁移的from标记。"
        },
        "source": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1,
          "description": "直接支持本状态事实的正式文档或UI，视觉状态含结构节点及原截图。"
        },
        "functionalFacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          },
          "minItems": 0,
          "description": "需验收的数据、规则或功能结果事实；无此类事实时为[]。"
        },
        "visualFacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          },
          "minItems": 0,
          "description": "需验收的可见内容、选中表现或结构事实；无此类事实时为[]。两类事实至少一类非空。"
        }
      },
      "required": [
        "id",
        "title",
        "statement",
        "isInitial",
        "source",
        "functionalFacts",
        "visualFacts"
      ],
      "additionalProperties": false,
      "description": "同一场景中同时成立、可观察可验收的视觉或功能事实。按通用判定规则识别验收差异、复用等价场景及处理前提延续。"
    },
    "operation": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "object"
        }
      },
      "required": [
        "label",
        "actor"
      ],
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "match": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "sampleOutcome": {
          "type": "object"
        },
        "observation": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "locator": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "method",
            "locator"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "statement",
        "match",
        "sampleOutcome",
        "observation"
      ],
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "source": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1
        },
        "condition": {
          "$ref": "#/$defs/condition"
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "assertion": {
                "$ref": "#/$defs/assertion"
              }
            },
            "required": [
              "statement",
              "assertion"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "operation",
        "source"
      ],
      "additionalProperties": false
    },
    "constraint": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "statement",
        "source"
      ],
      "additionalProperties": false
    }
  },
  "description": "仅约束最终状态迁移图：状态、迁移、全局约束及必要文件元数据。",
  "$comment": "需求分析与澄清的工作记录由独立analysis-work.schema.json约束，不属于本Schema的字段或定义。工作记录在任务完成后删除。"
}
