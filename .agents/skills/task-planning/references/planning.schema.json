    "schemaVersion": {
      "const": 1
    },
    "analysisId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "requirementsPath": {
          "type": "string",
          "minLength": 1
        },
        "requirementsSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "requirementsDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "gatePath": {
          "type": "string",
          "minLength": 1
        },
        "gateSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "requirementsPath",
        "requirementsSha256",
        "requirementsDigest",
        "gatePath",
        "gateSha256"
      ],
      "additionalProperties": false
    },
    "executionPolicy": {
      "type": "object",
      "properties": {
        "allowedLevels": {
          "type": "array",
          "items": {
            "enum": [
              "unit",
              "integration"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "browserAcceptance": {
          "const": false
        },
        "fixtureMode": {
          "const": "isolated"
        },
        "onFailure": {
          "const": "stop"
        },
        "entryRule": {
          "const": "previous_passed_edge"
        },
        "rootRule": {
          "const": "no_external_preconditions"
        }
      },
      "required": [
        "allowedLevels",
        "browserAcceptance",
        "fixtureMode",
        "onFailure",
        "entryRule",
        "rootRule"
      ],
      "additionalProperties": false
