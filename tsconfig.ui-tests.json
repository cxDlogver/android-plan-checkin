{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "outDir": ".cache/ui-tests",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": [
    "tests/ui/**/*.ts",
    "src/ui/bindings.ts",
    "src/ui/spec-types.ts",
    "src/ui/spec-tokens.ts",
    "src/ui/spec-documents.ts",
    "src/ui/plan-form-presentation.ts",
    "src/ui/record-presentation.ts",
    "src/verification/ui-browse-model.ts",
    "src/verification/ui-data-context.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
