{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "types": ["node"],
    "outDir": ".artifacts/tests",
    "rootDir": "."
  },
  "include": ["src/domain/**/*.ts", "tests/domain/**/*.ts"],
  "exclude": ["node_modules", "resource"]
}
