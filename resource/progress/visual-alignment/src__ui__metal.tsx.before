import React, { useState } from 'react';
import { Alert, KeyboardAvoidingView, Modal, Platform, Pressable, ScrollView, StyleSheet, Text, TextInput, TextInputProps, View, ViewStyle } from 'react-native';
import { LinearGradient } from 'expo-linear-gradient';
import { SafeAreaView } from 'react-native-safe-area-context';
import { router } from 'expo-router';
import { businessToday, monthGrid, shiftMonth } from '../domain/date';

export const colors={background:'#E8ECF0',surface:'#FAFBFC',primary:'#263440',text:'#17212B',muted:'#4D5B68',border:'#ABB6C1',success:'#006E3A',failure:'#B62029',skip:'#8E4A00',gold:'#866500'};
export function Body({children,strong=false,title=false,style,...props}:React.ComponentProps<typeof Text>&{strong?:boolean;title?:boolean}){return <Text allowFontScaling {...props} style={[{fontFamily:title?'NotoSC700':strong?'NotoSC600':'NotoSC400',fontSize:title?22:15,color:colors.text},style]}>{children}</Text>;}
export function Tag({children,tone=colors.muted,testID}:{children:React.ReactNode;tone?:string;testID?:string}){return <View testID={testID} style={{alignSelf:'flex-start',maxWidth:'100%',paddingHorizontal:6,paddingVertical:3,borderRadius:1,borderWidth:1,borderColor:tone,backgroundColor:'#E0E6EB'}}><Body strong style={{fontSize:12,color:tone}}>{children}</Body></View>;}
export function Metal({children,style}:{children:React.ReactNode;style?:ViewStyle}){return <LinearGradient colors={['#FFFFFF','#F2F5F7','#E6ECF1']} locations={[0,.22,1]} style={[styles.metal,style]}>{children}</LinearGradient>;}
export function Button({title,onPress,disabled=false,testID,tone,selected=false,accessibilityLabel}:{title:string;onPress:()=>void;disabled?:boolean;testID?:string;tone?:string;selected?:boolean;accessibilityLabel?:string}){return <Pressable accessibilityRole="button" accessibilityLabel={accessibilityLabel||title} accessibilityState={{disabled,selected}} testID={testID} disabled={disabled} onPress={onPress} style={({pressed})=>[styles.button,{opacity:disabled ? .45 : pressed ? .75 : 1,borderColor:tone||colors.border}]}><LinearGradient colors={selected?['#687987','#354756','#243440','#16232D']:['#FFFFFF','#D4DAE0','#EEF2F5','#FFFFFF','#D7DFE6','#B9C4CE']} locations={selected?[0,.22,.7,1]:[0,.15,.4,.44,.48,1]} style={styles.buttonFill}><Body strong style={{textAlign:'center',color:selected?'#fff':tone||colors.primary}}>{title}</Body></LinearGradient></Pressable>;}
export function Choice({options,value,onChange,testID,disabled=false}:{options:{value:string;label:string;color?:string}[];value:string;onChange:(value:string)=>void;testID?:string;disabled?:boolean}){return <View style={styles.choices}>{options.map(option=><View key={option.value} style={{flexGrow:1,flexBasis:100}}><Button disabled={disabled} title={option.label} selected={value===option.value} tone={option.color} onPress={()=>onChange(option.value)} testID={testID?`${testID}.${option.value}`:undefined}/></View>)}</View>;}
export function Field({label,error,...props}:TextInputProps&{label:string;error?:string}){return <View style={{gap:8}}><Body strong>{label}</Body><TextInput {...props} accessibilityLabel={label} style={[styles.input,props.multiline&&{minHeight:100,textAlignVertical:'top'},props.style]} placeholderTextColor="#84919C"/><Body accessibilityRole={error?'alert':undefined} accessibilityLiveRegion={error?'polite':undefined} style={{fontSize:12,color:error?colors.failure:colors.muted}}>{error||''}</Body></View>;}
export function Page({title,children,back=false,right,scroll=true}:{title:string;children:React.ReactNode;back?:boolean;right?:React.ReactNode;scroll?:boolean}){const content=<View style={[{gap:16,paddingBottom:28},!scroll&&{flex:1}]}>{children}</View>;return <SafeAreaView edges={back?['top','bottom','left','right']:['top','left','right']} style={styles.screen}><View style={styles.header}>{back&&<Pressable accessibilityRole="button" accessibilityLabel="返回" style={{minWidth:48,minHeight:48,justifyContent:'center'}} onPress={()=>router.back()}><Body style={{fontSize:28}}>←</Body></Pressable>}<Body title accessibilityRole="header" style={{flex:1}}>{title}</Body>{right}</View><KeyboardAvoidingView style={{flex:1}} behavior={Platform.OS==='ios'?'padding':'height'}>{scroll?<ScrollView keyboardShouldPersistTaps="handled" contentContainerStyle={{paddingHorizontal:20,paddingTop:8}}>{content}</ScrollView>:content}</KeyboardAvoidingView></SafeAreaView>;}
export function Notice({children,error=false}:{children:React.ReactNode;error?:boolean}){return <View accessibilityRole="alert" style={{padding:14,borderWidth:1,borderColor:error?colors.failure:colors.border,backgroundColor:error?'#FBE8E9':'#F7EBCF'}}><Body style={{color:error?colors.failure:colors.text}}>{children}</Body></View>;}
export function DateField({label,value,onChange,min,max,nullable=false,zone,testID,error,disabled=false}:{label:string;value:string|null;onChange:(value:string|null)=>void;min?:string;max?:string;nullable?:boolean;zone:string;testID?:string;error?:string;disabled?:boolean}){
  const [open,setOpen]=useState(false),[month,setMonth]=useState((value||min||businessToday(Date.now(),zone)).slice(0,7));
  return <View style={{gap:8}}><Body strong>{label}</Body><TextInput accessibilityLabel={`${label}，YYYY-MM-DD`} placeholder="YYYY-MM-DD" editable={!disabled} value={value||''} onChangeText={text=>onChange(nullable&&text===''?null:text)} testID={testID?`${testID}.input`:undefined} style={styles.input}/><Button disabled={disabled} title="选择日期" testID={testID} onPress={()=>{setMonth((value&&/^\d{4}-\d{2}/.test(value)?value:min||businessToday(Date.now(),zone)).slice(0,7));setOpen(true);}}/>{error&&<Body accessibilityRole="alert" accessibilityLiveRegion="polite" style={{color:colors.failure}}>{error}</Body>}<Modal visible={open} transparent animationType="fade" onRequestClose={()=>setOpen(false)}><View style={[styles.overlay,{padding:4}]}><ScrollView style={{maxHeight:'95%'}} contentContainerStyle={[styles.dialog,{padding:4}]} keyboardShouldPersistTaps="handled"><Body title>{label}</Body><View style={styles.choices}><Button title="‹" accessibilityLabel="上个月" onPress={()=>setMonth(shiftMonth(month,-1,zone))}/><Body strong>{month}</Body><Button title="›" accessibilityLabel="下个月" onPress={()=>setMonth(shiftMonth(month,1,zone))}/></View><View style={styles.grid}>{['一','二','三','四','五','六','日'].map(day=><Body key={day} style={styles.day}>{day}</Body>)}{monthGrid(month,zone).map(day=>{const disabled=!!(min&&day<min||max&&day>max);return <Pressable key={day} accessibilityRole="button" accessibilityLabel={day} accessibilityState={{disabled,selected:value===day}} disabled={disabled} testID={`date-picker.${day}`} onPress={()=>{onChange(day);setOpen(false);}} style={[styles.day,{paddingVertical:14,opacity:disabled?.3:1,backgroundColor:value===day?'#D4DAE0':'transparent'}]}><Body style={{textAlign:'center'}}>{Number(day.slice(-2))}</Body></Pressable>;})}</View>{nullable&&<Button title="不设置结束日期" onPress={()=>{onChange(null);setOpen(false);}}/>}<Button title="取消" testID="confirmation.cancel" onPress={()=>setOpen(false)}/></ScrollView></View></Modal></View>;
}
export function confirm(title:string,message:string,destructive=false):Promise<boolean>{return new Promise(resolve=>Alert.alert(title,message,[{text:'取消',style:'cancel',onPress:()=>resolve(false)},{text:'确认',style:destructive?'destructive':'default',onPress:()=>resolve(true)}],{cancelable:true,onDismiss:()=>resolve(false)}));}
const styles=StyleSheet.create({screen:{flex:1,backgroundColor:colors.background},header:{paddingHorizontal:20,paddingVertical:12,flexDirection:'row',alignItems:'center',gap:12,minHeight:64},metal:{padding:16,gap:14,borderRadius:3,borderWidth:1,borderColor:'#fff',boxShadow:'0 3px 8px #2134461F, inset 0 1px 0 #FFFFFFE6'},button:{minWidth:48,minHeight:48,borderWidth:1,borderRadius:2,boxShadow:'0 2px 4px #15273733, inset 0 1px 0 #FFFFFF, inset 0 -1px 0 #8293A033'},buttonFill:{flexGrow:1,paddingVertical:13,paddingHorizontal:10,justifyContent:'center',borderRadius:1},choices:{flexDirection:'row',flexWrap:'wrap',gap:8,alignItems:'center'},input:{minHeight:52,fontFamily:'NotoSC400',fontSize:15,color:colors.text,backgroundColor:colors.surface,borderColor:colors.border,borderWidth:1,borderRadius:2,paddingHorizontal:12,paddingVertical:14,boxShadow:'inset 0 1px 3px #2437471A'},overlay:{flex:1,justifyContent:'center',backgroundColor:'#0008',padding:16},dialog:{backgroundColor:colors.background,padding:16,gap:16,maxHeight:'95%'},grid:{flexDirection:'row',flexWrap:'wrap'},day:{width:'14.2857%',textAlign:'center',minHeight:48}});

export function StatusFilter({value,onChange,counts}:{value:string;onChange:(value:string)=>void;counts:{all:number;completed:number;incomplete:number}}){
  const [open,setOpen]=useState(false);
  const options=[{value:'all',label:'全部状态'},{value:'completed',label:'已完成'},{value:'incomplete',label:'未完成'}] as const;
  const current=options.find(option=>option.value===value)!;
  return <View><Button title={current.label+'（'+counts[current.value]+'）'} accessibilityLabel={'状态筛选，'+current.label+'，'+counts[current.value]+'项'} testID="calendar.filter.open" onPress={()=>setOpen(true)}/><Modal transparent visible={open} onRequestClose={()=>setOpen(false)}><View style={styles.overlay}><Pressable accessible={false} testID="calendar.filter.outside" onPress={()=>setOpen(false)} style={StyleSheet.absoluteFill}/><View style={styles.dialog}><Body title>筛选状态</Body>{options.map(option=><Button key={option.value} title={option.label+'（'+counts[option.value]+'）'} selected={value===option.value} testID={'calendar.filter.'+option.value} onPress={()=>{onChange(option.value);setOpen(false);}}/>)}<Button title="关闭筛选" testID="calendar.filter.close" onPress={()=>setOpen(false)}/></View></View></Modal></View>;
}
