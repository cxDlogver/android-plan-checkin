  "verificationHarness": {
    "caseFunction": "async t=>{\n  await t.nav('/(tabs)/today');await t.click('plan.create');const before=await t.capture('before-facts');await t.frame('fixed-default');\n  t.check('AC016.A1.fields',['','2026-10-09',''],[await t.property('plan.name','text'),await t.property('plan.startsOn.input','text'),await t.property('plan.endOn.input','text')]);t.check('AC016.A2.disabled','false',await t.property('plan.save','enabled'));\n  for(let i=1;i<=7;i++)t.check(`AC016.A2.weekday-${i}`,'false',await t.property(`plan.weekday.${i}`,'selected'));\n  await t.type('weekly');t.check('AC016.A3.weekly-default','3',await t.property('plan.weeklyTarget','text'));await t.frame('weekly-default');\n  await t.type('one_time');t.check('AC016.A3.due-default','2026-10-09',await t.property('plan.dueOn.input','text'));await t.frame('one-default');t.check('AC016.A3.hidden-fields',false,(await t.device.source()).includes('plan.direction.avoid'));await t.unchanged(before,'AC016.no-default-write');\n}",
