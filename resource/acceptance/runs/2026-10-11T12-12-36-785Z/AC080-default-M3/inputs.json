    "caseFunction": "async t=>{await seed(t,1,0);const p=await t.create('weekly','2026-10-01');await t.clock('2026-10-09T12:00:00+08:00');await calendar(t);await t.device.seek('calendar.filter.open');await t.click('calendar.filter.open');await t.device.back();await t.device.waitSource(s=>!s.includes('筛选状态'));await t.textPresent('AC080.A1.back-keeps-all','全部状态（1）');await t.click('calendar.filter.open');await t.device.request(t.device.endpoint('execute/sync'),'POST',{script:'mobile: clickGesture',args:[{x:24,y:120}]});await t.frame('outside-tap-close');await t.device.waitSource(s=>!s.includes('筛选状态'));await t.textPresent('AC080.A1.outside-keeps-all','全部状态（1）');await filter(t,'completed');await t.textPresent('AC080.A2.filtered-empty','该日没有已完成项');await t.device.scroll('down');await t.textPresent('AC080.A3.independent-weekly','可补记的每周计划');const dto=await query(t,'2026-10-08');t.check('AC080.A3.not-in-main',false,dto.items.some(i=>i.plan.id===p));t.check('AC080.A3.eligible',true,dto.weeklyBackfills.some(x=>x.id===p));await t.frame('filtered-empty-and-weekly');}",
