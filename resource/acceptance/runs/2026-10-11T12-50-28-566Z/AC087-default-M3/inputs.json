  "verificationHarness": {
    "caseFunction": "async t=>{const p=await t.create('fixed','2026-10-09');await t.nav('/records/new',{planId:p,businessOn:'2026-10-09',result:'success'});await t.input('record.note','读失败保留草稿');const before=await t.capture('before-facts');await t.client.call('fault',{point:'read_io'});t.run.write('failed-refresh.json',await t.client.call('refresh'));await t.device.waitSource(s=>s.includes('无法读取本机数据'));await t.frame('blocked-old-DTO');t.check('AC087.A1.explicit-error',true,(await t.device.source()).includes('原数据和当前输入已保留'));await t.click('error.readRetry');await t.device.waitSource(s=>!s.includes('无法读取本机数据'));t.check('AC087.A3.draft-retained','读失败保留草稿',await t.property('record.note','text'));await t.unchanged(before,'AC087.A3.no-write-during-read-error');await t.command('ArchivePlan',{...await t.ref(p),eventId:randomUUID()});await t.command('PermanentlyDeletePlan',await t.ref(p));await t.device.waitSource(s=>s.includes('目标已永久删除'));t.check('AC087.A1.no-stale-save',false,(await t.device.source()).includes('record.save'));await t.frame('removed-old-object');await t.device.back();await t.device.waitSource(s=>s.includes('放弃未保存内容'));await t.device.text('确认');await t.device.waitSource(s=>s.includes('今日'));const dto=await query(t,'today');t.check('AC087.A2.source-invalidated',false,Object.values(dto.sections).flat().some(plan=>plan.id===p));}",
