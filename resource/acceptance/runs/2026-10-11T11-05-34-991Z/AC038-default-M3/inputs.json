    "caseFunction": "async t=>{\n for(const e of report.evidence)t.check('AC038.reuse.original-evidence-SHA',e.sha256,sha(fs.readFileSync(e.path)));t.run.write('reused-original-observations.json',{report:`${origin}/result.json`,sha256:sha(fs.readFileSync(`${origin}/result.json`)),assertions:report.assertions.filter(a=>a.status==='PASS'),correction:'Compare the first original note to the actual first submitted note. The committed first modification is reused and is not submitted again.'});\n const original=initial.facts.one_time_results[0],p=original.plan_id,id=original.id;await t.clock('2026-10-11T12:00:00+08:00');t.run.write('given-restored-committed-facts.json',committed.facts);await t.client.call('factsFixture',{facts:committed.facts,confirm:'RESET_ISOLATED_DEV_FACTS'});t.check('AC038.A3.actual-first-original',[{result_id:id,original_outcome:original.outcome,original_note:original.note}],committed.facts.one_time_result_originals.filter(r=>r.result_id===id));\n for(const outcome of ['cancelled','completed']){await t.nav('/records/[recordId]',{planId:p,recordId:id});await t.device.waitSource(s=>s.includes('record.note'));t.check('AC038.A1.no-date-control',false,(await t.device.source()).includes('record.actualCompletedOn.input'));await t.click(`record.result.${outcome}`);await t.input('record.note',outcome);await t.frame(`before-${outcome}-only-missing-When`);await save(t);const s=await t.capture(`after-${outcome}-facts`),result=s.facts.one_time_results.find(r=>r.id===id);t.check(`AC038.A1.identity-${outcome}`,[id,original.business_on,original.due_rule_version_id],[result.id,result.business_on,result.due_rule_version_id]);t.check(`AC038.A2.actual-${outcome}`,outcome==='completed'?original.business_on:null,result.actual_completed_on);t.check('AC038.A3.first-original-retained',[{result_id:id,original_outcome:original.outcome,original_note:original.note}],s.facts.one_time_result_originals.filter(r=>r.result_id===id));}\n await t.clock('2026-10-12T00:00:01+08:00');await t.nav('/records/[recordId]',{planId:p,recordId:id});await t.device.waitSource(s=>s.includes('只读记录'));t.check('AC038.A4.no-save',false,(await t.device.source()).includes('record.save'));t.check('AC038.A4.note-disabled','false',await t.property('record.note','enabled'));t.check('AC038.A4.no-withdraw',false,(await t.device.source()).includes('撤回'));await t.frame('final-next-day-readonly');\n}",
