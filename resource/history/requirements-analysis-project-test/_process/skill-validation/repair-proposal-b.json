  "operations": [
    {
      "action": "merge_obligation_then_remove_transition",
      "transitionId": "T-STATS-today-result",
      "removeRequirementId": "R-STATS-today-result",
      "targetRequirementId": "R-STATS-fixed",
      "targetStateId": "STATS.fixed",
      "assertions": [
        {
          "given": "固定计划历史与完成率，上下文满足：今天为合法有效日",
          "when": "普通当日结果提交或修订成功",
          "then": [
            "用旧记录贡献移除、新记录贡献加入重算：成功贡献(N,D)=(1,1)，失败(0,1)，跳过(0,0)且跳过数单列",
            "普通当日新增未提交之前不在S；修订同一业务日不增加日期数或重复分母",
            "当日结果与日历/详情一致，但日历跳过仍在日历T中，不能共用分母",
            "固定统计以成功日期数N和排除跳过后的候选日期数D为参数；D为零时显示“暂无可计算记录”而不显示百分比，D大于零时显示N/D和四舍五入整数百分比；跳过与未记录数单独展示",
            "当重算后分母由零变为正数时显示计算比率；由正数变为零时显示“暂无可计算记录”且不显示百分比；仍为正数时更新比率，始终按旧贡献移除、新贡献加入计算"
          ]
        },
        {
          "given": "历史已明确为6成功/8分母，今天是合法有效日且尚未提交",
          "when": "今天首次保存成功、失败或跳过之一",
          "then": [
            "成功7/9，失败6/9，跳过6/8并跳过数+1；这是该给定数据的示例"
          ]
        }
      ],
      "meaning": "聚合是实际合法提交后的状态约束，不是详情页可无事务直接触发的独立动作。合并为读取同一计划已保存数据时验证公式/变化事实；实际记录提交成功继续刷新跨页。",
      "sourceIds": [
        "PRD-FR17",
        "PRD-MATRIX",
        "UI-SPEC",
        "PRD-FR10"
      ]
    },
    {
      "action": "merge_obligation_then_remove_transition",
      "transitionId": "T-STATS-backfill",
      "removeRequirementId": "R-STATS-backfill",
      "targetRequirementId": "R-STATS-fixed",
      "targetStateId": "STATS.fixed",
      "assertions": [
        {
          "given": "固定计划历史与完成率，上下文满足：原日在既有候选分母内",
          "when": "历史未记录补成功提交成功",
          "then": [
            "原分母不新增，分子+1",
            "按所属业务日重聚合，不按提交日"
          ]
        }
      ],
      "meaning": "聚合是实际合法提交后的状态约束，不是详情页可无事务直接触发的独立动作。合并为读取同一计划已保存数据时验证公式/变化事实；实际记录提交成功继续刷新跨页。",
      "sourceIds": [
        "PRD-FR12",
        "PRD-FR17",
        "PRD-MATRIX",
        "UI-SPEC"
      ]
    },
    {
      "action": "merge_obligation_then_remove_transition",
      "transitionId": "T-STATS-weekly-record",
      "removeRequirementId": "R-STATS-weekly-record",
      "targetRequirementId": "R-STATS-weekly",
      "targetStateId": "STATS.weekly",
      "assertions": [
        {
          "given": "周进度与已结束完整周统计，上下文满足：同业务日唯一",
          "when": "合法周记录提交或修订成功",
          "then": [
            "按记录所属业务日期和当时规则重算所属周，不把历史补记归到提交日或今天",
            "成功业务日去重，失败和跳过不增加成功日；实际进度3/3可变4/3，进度条不超过100%",
            "所属周未结束时更新其进度，不提前计入历史达标率或连续",
            "所属周已结束且为完整有效周时，重算该周达标、历史达标分子及受影响的连续；完整有效已结束周分母不因每次记录提交额外增加",
            "中途开始、结束或暂停导致的非完整周继续按既有规则排除；没有完整周时显示“暂无完整周”"
          ]
        }
      ],
      "meaning": "聚合是实际合法提交后的状态约束，不是详情页可无事务直接触发的独立动作。合并为读取同一计划已保存数据时验证公式/变化事实；实际记录提交成功继续刷新跨页。",
      "sourceIds": [
        "PRD-FR04",
        "PRD-FR19",
        "PRD-MATRIX",
        "UI-SPEC",
        "PRD-FR12"
      ]
    },
    {
      "action": "update",
      "transitionId": "T-STATS-FIX-fixed-break",
      "event": "固定有效应执行日结束后重新读取当前连续",
      "guard": "已跨入下一业务日，刚结束的有效应执行日没有记录",
      "cases": [
