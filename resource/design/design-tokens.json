{
  "schemaVersion": 1,
  "designName": "计划打卡 Android V1",
  "theme": "light",
  "viewport": {
    "width": 393,
    "height": 852
  },
  "colors": {
    "background": "#E8ECF0",
    "surface": "#FAFBFC",
    "primary": "#263440",
    "text": "#17212B",
    "secondary": "#84919C",
    "mutedText": "#4D5B68",
    "border": "#ABB6C1",
    "primarySoft": "#E0E6EB",
    "calendarProgress": "#866500",
    "success": "#006E3A",
    "successSoft": "#E2F2E8",
    "failure": "#B62029",
    "failureSoft": "#FBE8E9",
    "skip": "#8E4A00",
    "skipSoft": "#FCEDD9",
    "warning": "#88500D",
    "warningSoft": "#F7EBCF"
  },
  "font": {
    "preferredFamily": "Noto Sans SC",
    "body": 15,
    "caption": 12,
    "title": 22,
    "titleWeight": 700,
    "sectionWeight": 700,
    "labelWeight": 600,
    "calendarDate": 12,
    "calendarFraction": 10,
    "calendarFractionWeight": 600,
    "section": 16,
    "lineHeightRatio": 1.5
  },
  "spacing": [
    4,
    8,
    12,
    16,
    24,
    32
  ],
  "radius": {
    "control": 2,
    "card": 3,
    "panel": 3,
    "tag": 1
  },
  "minimumTouchTarget": 48,
  "notes": [
    "银色多段渐变、边缘高光与软投影配合，关键面板使用明显金属反光带。",
    "按钮2px、卡片/面板3px、标签1px圆角；避免胶囊形状。",
    "✓成功绿色，×失败红色，—跳过橙色；保留文字与符号，选择态用对应浅色底。",
    "页面边距20px，卡片内边距16px，输入内边距上下14px/左右12px，内容块间距16px。",
    "页面与区块标题700字重，重要标签600–700。",
    "实际安卓字体缩放、触控、安全区及阴影仍需运行验证。",
    "日历分数下标10sp、600字重，日期12sp；分数使用金黄色calendarProgress，完成勾保持绿色，今天无下标。"
  ],
  "style": "polished-metal",
  "gradients": {
    "button": {
      "type": "gradient",
      "gradientType": "linear",
      "rotation": 180,
      "colors": [
        {
          "color": "#FFFFFF",
          "position": 0
        },
        {
          "color": "#D4DAE0",
          "position": 0.15
        },
        {
          "color": "#EEF2F5",
          "position": 0.4
        },
        {
          "color": "#FFFFFF",
          "position": 0.44
        },
        {
          "color": "#D7DFE6",
          "position": 0.48
        },
        {
          "color": "#B9C4CE",
          "position": 1
        }
      ]
    },
    "silver": {
      "type": "gradient",
      "gradientType": "linear",
      "rotation": 135,
      "colors": [
        {
          "color": "#FFFFFF",
          "position": 0
        },
        {
          "color": "#E3E9EE",
          "position": 0.22
        },
        {
          "color": "#D4DAE0",
          "position": 0.46
        },
        {
          "color": "#FDFEFF",
          "position": 0.5
        },
        {
          "color": "#E5EBF0",
          "position": 0.56
        },
        {
          "color": "#CDD6DE",
          "position": 1
        }
      ]
    },
    "card": {
      "type": "gradient",
      "gradientType": "linear",
      "rotation": 180,
      "colors": [
        {
          "color": "#FFFFFF",
          "position": 0
        },
        {
          "color": "#F2F5F7",
          "position": 0.22
        },
        {
          "color": "#E6ECF1",
          "position": 1
        }
      ]
    },
    "rim": {
      "type": "gradient",
      "gradientType": "linear",
      "rotation": 180,
      "colors": [
        {
          "color": "#FFFFFF",
          "position": 0
        },
        {
          "color": "#BAC5CF",
          "position": 0.22
        },
        {
          "color": "#97A4B0",
          "position": 0.55
        },
        {
          "color": "#F7FAFC",
          "position": 1
        }
      ]
    },
    "graphite": {
      "type": "gradient",
      "gradientType": "linear",
      "rotation": 180,
      "colors": [
        {
          "color": "#687987",
          "position": 0
        },
        {
          "color": "#354756",
          "position": 0.22
        },
        {
          "color": "#243440",
          "position": 0.7
        },
        {
          "color": "#16232D",
          "position": 1
        }
      ]
    }
  },
  "effects": {
    "card": [
      {
        "type": "shadow",
        "shadowType": "outer",
        "offset": {
          "x": 0,
          "y": 3
        },
        "blur": 8,
        "color": "#2134461F"
      },
      {
        "type": "shadow",
        "shadowType": "inner",
        "offset": {
          "x": 0,
          "y": 1
        },
        "blur": 0,
        "color": "#FFFFFFE6"
      }
    ],
    "button": [
      {
        "type": "shadow",
        "shadowType": "outer",
        "offset": {
          "x": 0,
          "y": 2
        },
        "blur": 4,
        "color": "#15273733"
      },
      {
        "type": "shadow",
        "shadowType": "inner",
        "offset": {
          "x": 0,
          "y": 1
        },
        "blur": 0,
        "color": "#FFFFFF"
      },
      {
        "type": "shadow",
        "shadowType": "inner",
        "offset": {
          "x": 0,
          "y": -1
        },
        "blur": 0,
        "color": "#8293A033"
      }
    ],
    "input": [
      {
        "type": "shadow",
        "shadowType": "inner",
        "offset": {
          "x": 0,
          "y": 1
        },
        "blur": 3,
        "color": "#2437471A"
      }
    ]
  },
  "layout": {
    "pageInset": 20,
    "cardPadding": 16,
    "inputPadding": [
      14,
      12
    ],
    "sectionGap": 16,
    "controlGap": 8,
    "calendar": {
      "panelPadding": [
        16,
        2
      ],
      "monthHeaderAdditionalPadding": [
        0,
        14
      ],
      "monthHeaderEffectiveHorizontalInset": 16,
      "weekdayColumnGap": 2,
      "dateColumnGap": 2,
      "weekdayTextAlign": "center",
      "minimumDateTouchTarget": 48
    }
  }
}
