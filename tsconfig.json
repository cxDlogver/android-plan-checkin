{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["react"],
    "paths": { "@/*": ["./src/*"], "@verification": ["./src/verification/contract.ts"], "@verification/runtime": ["./src/verification/runtime-contract.ts"] }
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx", "expo-env.d.ts"],
  "exclude": ["tests", "scripts", "resource", "node_modules", ".artifacts"]
}
